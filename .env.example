# 服务端口（Render 会自动注入 PORT）
PORT=8787

# 大模型（任何 OpenAI 兼容接口）。留空则只能手填脚本，不能自动生成。
# Render 上请在 Dashboard → Environment 里配置同名变量，不要把密钥写进仓库。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# 模型名，例如 gpt-4o-mini / qwen-plus / deepseek-chat
LLM_MODEL=gpt-4o-mini

# 可选：用于热榜聚合的自定义源（JSON，格式见 README）
HOT_EXTRA_URL=
